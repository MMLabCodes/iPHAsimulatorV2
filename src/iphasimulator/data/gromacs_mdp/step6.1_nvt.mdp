; Polymer-only GAFF2 NVT equilibration
; Length: 100 ps (50000 steps x 0.002 ps).
; Conditions: NVT at 300 K, V-rescale thermostat, no pressure coupling.
; Initial velocities are generated in this stage.
integrator              = md
nsteps                  = 50000
dt                      = 0.002
continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
tcoupl                  = V-rescale
tc-grps                 = System
tau_t                   = 1.0
ref_t                   = 300
pcoupl                  = no
pbc                     = xyz
gen_vel                 = yes
gen_temp                = 300
gen_seed                = -1
nstenergy               = 500
nstlog                  = 500
