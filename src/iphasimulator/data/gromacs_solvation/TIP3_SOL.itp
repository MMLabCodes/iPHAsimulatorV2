;;
;; TIP3 water include for the standard GROMACS solvate route.
;;
;; gmx solvate with spc216.gro writes water molecules named SOL with atom names
;; OW/HW1/HW2. This file keeps the uploaded CHARMM-GUI TIP3 charges, masses,
;; SETTLE geometry, and OT/HT atom types, but exposes the molecule as SOL so
;; the generated topology matches the coordinate file.
;;

[ moleculetype ]
; name  nrexcl
SOL     2

[ atoms ]
; nr  type  resnr  residu  atom  cgnr  charge     mass
1     OT    1      SOL     OW    1    -0.834000   15.9994
2     HT    1      SOL     HW1   2     0.417000    1.0080
3     HT    1      SOL     HW2   3     0.417000    1.0080

[ settles ]
; OW  funct  doh           dhh
1     1      9.572000e-02  1.513900e-01

[ exclusions ]
1     2     3
2     1     3
3     1     2
